class book:
    def __init__(self, title, author, pages):
        self.title = title
        self.author = author
        self.pages = pages

    def showbook(self):
        print(
            f"the book name is {self.title} and the author is {self.author} and there are {self.pages}"
        )

    def __str__(self):
        return f"the book name is {self.title} and the author is {self.author} and there are {self.pages}"

    def __len__(self):
        return self.pages

    def __eq__(self, other):
        if not isinstance(other, book):
            return False

        return (
            self.title == other.title
            and self.author == other.author 
            and self.pages == other.pages
        )


a = book("ram", "raghav", 787)
a.showbook()
print(a)
