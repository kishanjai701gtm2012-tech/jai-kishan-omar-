import random

a = ["abc", "bfg", "bgs", "ghn", "phs", "bgs", "fgb"]
y = ["avc", "bvg", "mgs", "hhn", "ghs", "zgs", "pgb"]
a1 = random.choice(a)
a2 = random.choice(y)
while True:
    work = input("encrypt aur decrypt: ")
    if work == "encrypt".lower():
        nword = []
        m = input("enter your message: ")
        words = m.split(" ")
        for word in words:
            if len(word) >= 3:
                mnew = a1+ word[1:] + word[0] + a2
                nword.append(mnew) 
            else: 
              nword.append(word[::-1])

        print(" ".join(nword))
    elif  work == "decrypt".lower()  :
       nword = []
       m = input("enter your message: ")
       words = m.split(" ")
       for word in words : 
         if len(word) >3 :
           r = word[3:-3]
           rnew = r[-1] + r[:-1]
           nword.append(rnew)
         else: 
           nword.append(word[::-1])
       print(" ".join(nword))
    else: 
      print("invalid input ")
      continue 
      
